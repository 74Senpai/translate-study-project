# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — copy this file to .env and fill in your values
#  All variables have sensible defaults; only set what you need to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Translate Platform API
APP_VERSION=1.0.0
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, set this to your actual frontend URL(s).
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=10000/minute

# ── Security & Cookies ────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_MAX_AGE: Expiry for the refresh_token cookie (in seconds). Default: 2592000 (30 days)
COOKIE_MAX_AGE=2592000
# COOKIE_DOMAIN=deeptranslate.org

# ── NLP ───────────────────────────────────────────────────────────────────────
# SpaCy language model — must be installed: python -m spacy download en_core_web_sm
SPACY_MODEL=en_core_web_sm

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Connection string to MongoDB Atlas (or local instance)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB_NAME=translate_db

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_role_key
# ── AI Translation ─────────────────────────────────────────────────────────────
# Set AI_TRANSLATE_ENABLE=true to use Gemini API for translation (recommended).
# When false (default), the free googletrans library is used as fallback.
# Get your API key at: https://aistudio.google.com/app/apikey
# Only Vietnamese ↔ English is supported.
AI_TRANSLATE_ENABLE=false
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
# Hard cap on Gemini API calls per calendar day (UTC). 0 = unlimited.
# Prevents DoS / accidental token exhaustion. Default: 500
AI_DAILY_LIMIT=500
