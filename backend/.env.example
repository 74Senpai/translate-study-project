# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — copy this file to .env and fill in your values
#  All variables have sensible defaults; only set what you need to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Translate Platform API
APP_VERSION=1.0.0
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, set this to your actual frontend URL(s).
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=10000/minute

# ── Security & Cookies ────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_MAX_AGE: Expiry for the refresh_token cookie (in seconds). Default: 2592000 (30 days)
COOKIE_MAX_AGE=2592000
# COOKIE_DOMAIN=deeptranslate.org

# ── NLP & WSD ─────────────────────────────────────────────────────────────────
# SpaCy language model — must be installed: python -m spacy download en_core_web_sm
SPACY_MODEL=en_core_web_sm

# Word Sense Disambiguation (WSD) 5-method weights (will be normalised to sum=1.0)
# M1: Sentence embedding vs synonym-substituted sentence
WSD_WEIGHT_SENTENCE_EMBED=40
# M2: Context window embedding vs synonym-substituted context window
WSD_WEIGHT_CTX_SYNONYM=30
# M3: WordNet Lesk overlap algorithm
WSD_WEIGHT_LESK=10
# M4: Context window embedding vs sense definition embedding
WSD_WEIGHT_CTX_DEFINITION=10
# M5: Generated example (same word count) embedding similarity
WSD_WEIGHT_GENERATED_EXAMPLE=10
WSD_CONTEXT_WINDOW_SIZE=5
# Top K results for synonym embedding score normalization formula (default: 6)
WSD_TOP_K=6
# Maximum synonyms retrieved per sense (default: 5)
WSD_MAX_SYNONYMS=5
# Trust threshold: composite score >= threshold marks sense as trusted
WSD_TRUST_THRESHOLD=0.65

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Connection string to MongoDB Atlas (or local instance)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB_NAME=translate_db

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_role_key
# ── AI Translation ─────────────────────────────────────────────────────────────
# Set AI_TRANSLATE_ENABLE=true to use Gemini API for translation (recommended).
# When false (default), the free googletrans library is used as fallback.
# Get your API key at: https://aistudio.google.com/app/apikey
# Only Vietnamese ↔ English is supported.
AI_TRANSLATE_ENABLE=false
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
# Hard cap on Gemini API calls per calendar day (UTC). 0 = unlimited.
# Prevents DoS / accidental token exhaustion. Default: 500
AI_DAILY_LIMIT=500
