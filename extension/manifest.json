{
  "manifest_version": 3,
  "name": "DeepTranslate",
  "version": "1.0.0",
  "description": "Dịch và phân tích ngữ pháp tiếng Anh tức thì",

  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "identity",
    "alarms",
    "tabs"
  ],

  "host_permissions": [
    "https://api.deeptranslate.org/*",
    "https://deeptranslate.org/*",
    "http://localhost/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "popup.html?view=sidepanel"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepTranslate",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },

  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["config.js", "content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "author": "DeepTranslate Project",
  "homepage_url": "https://deeptranslate.org",
  "key": ""
}